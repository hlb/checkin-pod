flowchart TB
    CSV["📥 活動 CSV<br/>Luma / KKTIX"]
    SELECT{"選擇報到模式"}
    PARSE["⚙️ 瀏覽器解析 CSV"]
    IDB["💾 IndexedDB<br/>活動快取與完整原始欄位"]
    MINIMIZE["🛡️ 伺服器欄位最小化<br/>必要欄位 + 選取顯示欄位"]
    IMPORT["📤 begin / upload / finalize<br/>每批 200 人"]

    subgraph SINGLE["單機模式"]
        SINGLE_LANE["🔐 單機主工作站<br/>HttpOnly lane session"]
        SINGLE_SCAN["🎫 同瀏覽器 /scan<br/>每筆立即送出"]
    end

    subgraph MULTI["多機模式"]
        LANES["🎫 每個入口建立<br/>fragment 啟用連結"]
        COOKIE["🔐 HttpOnly lane session<br/>清除網址中的 secret"]
        MULTI_SCAN["📥 多入口 /scan<br/>每筆立即送出"]
    end

    SCAN_API["🌐 scan API<br/>cookie 驗證、限流與 key hash 查找"]
    ATOMIC["✅ 條件 UPDATE<br/>checked_in_at IS NULL"]
    ACTIVITY["📝 activity log<br/>唯一 request ID"]
    CHANGES["🔄 ordered changes feed<br/>cursor reconciliation"]
    D1[("🗄️ D1<br/>每場 event_id 隔離<br/>30 天到期日")]
    PUBLIC["📊 公開 projection feed<br/>預設匿名、可選遮罩或姓名"]

    CSV --> SELECT
    SELECT --> PARSE
    PARSE --> IDB
    PARSE --> MINIMIZE
    MINIMIZE --> IMPORT
    IMPORT --> D1
    D1 -->|"預設"| SINGLE_LANE
    SINGLE_LANE --> SINGLE_SCAN
    SINGLE_SCAN --> SCAN_API
    D1 -->|"多入口"| LANES
    LANES --> COOKIE
    COOKIE --> MULTI_SCAN
    MULTI_SCAN --> SCAN_API
    SCAN_API --> ATOMIC
    ATOMIC --> D1
    SCAN_API --> ACTIVITY
    ACTIVITY --> D1
    D1 --> CHANGES
    CHANGES --> IDB
    D1 --> PUBLIC

    classDef input fill:#FFF3D6,stroke:#7A4B00,stroke-width:2px,color:#251700
    classDef decision fill:#FFE5CC,stroke:#A14300,stroke-width:2px,color:#321400
    classDef local fill:#E8F2FF,stroke:#0B4F8A,stroke-width:2px,color:#071E33
    classDef shared fill:#E8F8EE,stroke:#176B3A,stroke-width:2px,color:#092617
    classDef store fill:#F3E8FF,stroke:#68419B,stroke-width:2px,color:#241238
    classDef public fill:#FFF0F4,stroke:#9A2A50,stroke-width:2px,color:#350D1B

    class CSV input
    class SELECT decision
    class PARSE,IDB local
    class IMPORT,MINIMIZE,SINGLE_LANE,SINGLE_SCAN,LANES,COOKIE,MULTI_SCAN,SCAN_API,ATOMIC,ACTIVITY,CHANGES shared
    class D1 store
    class PUBLIC public
